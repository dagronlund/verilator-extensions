builddir = build

rule prepare
  command = mkdir -p build && rm -f build/*_activetop.tree.json build/ast.json && touch $out
  description = PREPARE $out

rule verilate
  command = verilator --cc -fno-table -Wno-ASCRANGE --dump-tree-json --coverage-user --formal-wires --top-module data_types --Mdir build tb.sv && cp build/*_activetop.tree.json build/ast.json && touch $out
  description = VERILATE $in

build build/.prepared: prepare tb.sv
build build/.verilated: verilate tb.sv | build/.prepared

default build/.verilated
