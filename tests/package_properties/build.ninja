builddir = build

rule prepare
  command = mkdir -p build && rm -f build/ast.json && touch $out
  description = PREPARE $out

rule verilate
  command = verilator --cc -fno-table -fno-delayed --ast-pre-codegen build/ast.json --coverage-user --sva-preserve --top-module package_properties --Mdir build tb.sv && touch $out
  description = VERILATE $in

build build/.prepared: prepare tb.sv
build build/.verilated: verilate tb.sv | build/.prepared

default build/.verilated
