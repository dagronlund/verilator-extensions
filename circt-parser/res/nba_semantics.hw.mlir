module {
  hw.module @nba_semantics(in %clk : i1, in %reset_n : i1, in %enable : i1, in %index : i1, in %data : i8, out a : i8, out b : i8, out pipeline : i8, out packed_value : i8, out temp_result : i8, out mem0 : i8, out mem1 : i8, out blocking_count : i8, out lane0 : i8, out lane1 : i8) {
    %true = hw.constant true
    %0 = hw.aggregate_constant [0 : i8, 0 : i8] : !hw.array<2xi8>
    %false = hw.constant false
    %c0_i4 = hw.constant 0 : i4
    %c-2_i2 = hw.constant -2 : i2
    %c0_i8 = hw.constant 0 : i8
    %c2_i8 = hw.constant 2 : i8
    %c1_i8 = hw.constant 1 : i8
    %1 = hw.array_get %lanes[%true] : !hw.array<2xi8>, i1
    %2 = hw.array_get %lanes[%false] : !hw.array<2xi8>, i1
    %3 = hw.array_get %memory[%true] : !hw.array<2xi8>, i1
    %4 = hw.array_get %memory[%false] : !hw.array<2xi8>, i1
    %5 = comb.add bin %data, %c1_i8 : i8
    %6 = comb.extract %5 from 0 : (i8) -> i4
    %7 = comb.extract %data from 4 : (i8) -> i4
    %8 = comb.extract %5 from 3 : (i8) -> i1
    %9 = comb.extract %5 from 0 : (i8) -> i1
    %10 = comb.concat %7, %8, %c-2_i2, %9 : i4, i1, i2, i1
    %11 = comb.sub bin %true, %index : i1
    %12 = hw.array_inject %memory[%11], %data : !hw.array<2xi8>, i1
    %13 = comb.xor bin %index, %true : i1
    %14 = comb.sub bin %true, %13 : i1
    %15 = hw.array_get %12[%14] : !hw.array<2xi8>, i1
    %16 = comb.extract %15 from 4 : (i8) -> i4
    %17 = comb.concat %16, %6 : i4, i4
    %18 = hw.array_inject %12[%14], %17 : !hw.array<2xi8>, i1
    %19 = comb.and bin %enable, %reset_n : i1
    %20 = comb.mux bin %19, %b, %c1_i8 : i8
    %21 = comb.mux bin %19, %a, %c2_i8 : i8
    %22 = comb.mux bin %19, %10, %c0_i8 : i8
    %23 = comb.mux bin %19, %18, %0 : !hw.array<2xi8>
    %24 = comb.xor bin %enable, %true : i1
    %25 = comb.and bin %reset_n, %24 : i1
    %26 = comb.xor bin %19, %true : i1
    %27 = comb.or bin %25, %26 : i1
    %28 = comb.mux bin %27, %c0_i8, %5 : i8
    %29 = comb.xor bin %25, %true : i1
    %30 = comb.and bin %29, %19 : i1
    %31 = comb.and bin %29, %19, %13 : i1
    %32 = seq.to_clock %clk
    %33 = comb.mux bin %25, %a, %20 : i8
    %a = seq.firreg %33 clock %32 : i8
    %34 = comb.mux bin %25, %b, %21 : i8
    %b = seq.firreg %34 clock %32 : i8
    %35 = comb.mux bin %25, %packed_value, %22 : i8
    %packed_value = seq.firreg %35 clock %32 : i8
    %36 = comb.mux bin %25, %temp_result, %28 : i8
    %temp_result = seq.firreg %36 clock %32 : i8
    %37 = comb.mux bin %25, %memory, %23 : !hw.array<2xi8>
    %memory = seq.firreg %37 clock %32 : !hw.array<2xi8>
    %38 = comb.mux bin %30, %28, %temporary : i8
    %temporary = seq.firreg %38 clock %32 : i8
    %39 = comb.mux bin %30, %31, %address : i1
    %address = seq.firreg %39 clock %32 : i1
    %40 = comb.mux bin %19, %a, %c0_i8 : i8
    %41 = comb.xor bin %reset_n, %true : i1
    %42 = comb.or bin %41, %enable : i1
    %43 = comb.mux bin %42, %40, %pipeline : i8
    %pipeline = seq.firreg %43 clock %32 : i8
    %44 = comb.add bin %blocking_count, %c1_i8 : i8
    %45 = comb.mux bin %reset_n, %44, %c0_i8 : i8
    %blocking_count = seq.firreg %45 clock %32 : i8
    %46 = comb.extract %1 from 4 : (i8) -> i4
    %47 = comb.concat %46, %c0_i4 : i4, i4
    %48 = hw.array_inject %lanes[%true], %47 : !hw.array<2xi8>, i1
    %49 = hw.array_get %48[%false] : !hw.array<2xi8>, i1
    %50 = comb.extract %49 from 4 : (i8) -> i4
    %51 = comb.concat %50, %c0_i4 : i4, i4
    %52 = hw.array_create %47, %51 : i8
    %53 = comb.extract %data from 0 : (i8) -> i4
    %54 = hw.array_get %lanes[%11] : !hw.array<2xi8>, i1
    %55 = comb.extract %54 from 4 : (i8) -> i4
    %56 = comb.concat %55, %53 : i4, i4
    %57 = hw.array_inject %lanes[%11], %56 : !hw.array<2xi8>, i1
    %58 = comb.mux bin %19, %57, %52 : !hw.array<2xi8>
    %59 = comb.mux bin %25, %lanes, %58 : !hw.array<2xi8>
    %60 = hw.array_get %59[%true] : !hw.array<2xi8>, i1
    %61 = comb.extract %60 from 0 : (i8) -> i4
    %62 = comb.concat %c0_i4, %61 : i4, i4
    %63 = hw.array_inject %59[%true], %62 : !hw.array<2xi8>, i1
    %64 = hw.array_get %63[%false] : !hw.array<2xi8>, i1
    %65 = comb.extract %64 from 0 : (i8) -> i4
    %66 = comb.concat %c0_i4, %65 : i4, i4
    %67 = hw.array_create %62, %66 : i8
    %68 = hw.array_get %59[%11] : !hw.array<2xi8>, i1
    %69 = comb.extract %68 from 0 : (i8) -> i4
    %70 = comb.concat %7, %69 : i4, i4
    %71 = hw.array_inject %59[%11], %70 : !hw.array<2xi8>, i1
    %72 = comb.mux bin %19, %71, %67 : !hw.array<2xi8>
    %73 = comb.mux bin %25, %lanes, %72 : !hw.array<2xi8>
    %lanes = seq.firreg %73 clock %32 : !hw.array<2xi8>
    %74 = seq.compreg %a, %32 : i8  
    %75 = comb.icmp eq %pipeline, %74 : i8
    %76 = comb.and %reset_n, %enable : i1
    %77 = comb.xor %reset_n, %true : i1
    %78 = seq.firreg %76 clock %32 reset async %77, %false preset 0 : i1
    verif.clocked_assert %75 if %78, posedge %clk : i1
    %79 = seq.compreg %blocking_count, %32 : i8  
    %80 = comb.add bin %79, %c1_i8 : i8
    %81 = comb.icmp eq %blocking_count, %80 : i8
    %82 = seq.firreg %reset_n clock %32 reset async %77, %false preset 0 : i1
    verif.clocked_assert %81 if %82, posedge %clk : i1
    %circt_past_valid = seq.firreg %true clock %32 preset 0 : i1
    %83 = comb.icmp eq %reset_n, %circt_past_valid : i1
    verif.clocked_assume %83, posedge %clk : i1
    hw.output %a, %b, %pipeline, %packed_value, %temp_result, %3, %4, %blocking_count, %1, %2 : i8, i8, i8, i8, i8, i8, i8, i8, i8, i8
  }
}

